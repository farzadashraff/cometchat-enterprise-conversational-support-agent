# Copy this file to .env and adjust values as needed. Do not commit real secrets.
# All variables are prefixed ASTER_ROW_ and are optional (sane defaults are used
# when unset). See src/aster_row_agent/config.py for the authoritative list.

# Directory containing the supplied knowledge-base Markdown files.
ASTER_ROW_KNOWLEDGE_BASE_DIR=knowledge-base

# Directory for generated/derived artifacts (index, embedding model cache).
# Never commit this directory; it is gitignored and fully rebuildable.
ASTER_ROW_DATA_DIR=.data

# Local embedding model used to build the vector index (downloaded once and
# cached under ASTER_ROW_DATA_DIR/embedding_cache; no API key required).
ASTER_ROW_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Maximum characters per chunk before a heading section is safely sub-split.
ASTER_ROW_MAX_CHUNK_CHARS=1200

# Logging verbosity for structured (JSON) logs.
ASTER_ROW_LOG_LEVEL=INFO

# --- LLM provider (Phase 5: agent/llm.py) ---

# The only required secret. Read directly from the environment by the
# `anthropic` SDK — never stored in, or logged by, this application's own
# config or trace output. Get a key at https://console.anthropic.com/
# Leave unset to run entirely with FakeLLMClient (all tests do this; no
# real key is ever required to run the test suite).
ANTHROPIC_API_KEY=

# Model, output size, and per-request timeout for the LLM client.
ASTER_ROW_LLM_MODEL=claude-haiku-4-5-20251001
ASTER_ROW_LLM_MAX_TOKENS=1024
ASTER_ROW_LLM_TIMEOUT_SECONDS=30
